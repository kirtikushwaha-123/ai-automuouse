# RootCause AI Configuration Template
# Copy this file to .env and supply your credentials if running in live mode.

# LLM Provider Configuration (Optional for live mode; simulated mode requires no keys)
# Supported values: openai, groq, ollama, deepseek, mock
ROOTCAUSE_LLM_PROVIDER=openai

# LLM API Credentials (Required ONLY for live evaluation mode)
ROOTCAUSE_LLM_API_KEY=your-api-key-here
# OPENAI_API_KEY=your-api-key-here

# API Base URL (Default: https://api.openai.com/v1)
# For Ollama: http://localhost:11434/v1
# For Local vLLM/LiteLLM: http://localhost:8000/v1
ROOTCAUSE_LLM_BASE_URL=https://api.openai.com/v1

# Default Model Identifier
ROOTCAUSE_LLM_MODEL=gpt-4o-mini

# Database Configuration
ROOTCAUSE_DB_PATH=rootcause.db

# API Service Configuration
ROOTCAUSE_API_HOST=127.0.0.1
ROOTCAUSE_API_PORT=8000
